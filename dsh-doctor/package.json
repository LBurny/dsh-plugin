{
  "name": "dsh-doctor",
  "version": "0.2.0",
  "description": "Harness diagnostics from inside DeepSeek Harness, aimed at debugging a plugin set: the harness's own log records read in-process (there is no log file to tail on the official desktop app), every row of the plugin tree with its activation state, and whichever log files do exist. Ships a panel and the /doctor command. dsh-doctor：在 dsh 本体里诊断这套插件——进程内抓取全部日志记录、逐个列出插件行的激活状态，外加真实存在的日志文件尾巴，自带面板与 /doctor 命令。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "ui": {
      "feature": {
        "key": "doctor",
        "order": 60,
        "title": {
          "zh": "诊断",
          "en": "Doctor"
        },
        "summary": {
          "zh": "运行状态与日志尾部",
          "en": "Status and log tail"
        }
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diagnostics",
    "doctor",
    "logs",
    "诊断",
    "日志"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "dsh-doctor"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/dsh-doctor#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
