{
  "name": "dsh-features",
  "version": "0.1.0",
  "description": "A single home for the dsh-* feature plugins of this repository: one sidebar entry (功能管理) with a page that mounts every installed feature inline, in one skin, instead of a stack of floating corner buttons. dsh-features：本仓功能插件的统一入口，侧栏一项承载全部功能，浮动按钮不再堆叠。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "features",
    "hub",
    "ui",
    "功能管理"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "dsh-features"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/dsh-features#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
