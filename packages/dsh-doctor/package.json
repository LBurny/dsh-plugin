{
  "name": "dsh-doctor",
  "version": "0.1.0",
  "description": "Harness diagnostics from inside DeepSeek Harness: version, port, pid, uptime, memory, profile and a log tail, reading the desktop shell's events.log when running under DSHDesktop. Ships a panel and the /doctor command. dsh-doctor：在 dsh 本体里查看运行状态与日志尾部，自带面板与 /doctor 命令。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "locale",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diagnostics",
    "doctor",
    "logs",
    "诊断",
    "日志"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "packages/dsh-doctor"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/packages/dsh-doctor#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
