{
  "name": "dsh-skills",
  "version": "0.1.0",
  "description": "Manage DeepSeek Harness skills from inside dsh: list, enable/disable, delete, and import from other agent tool roots or a local ZIP archive. Ships a panel and the /skills command. dsh-skills：在 dsh 本体里管理技能——列表、启停、删除，以及从其它 agent 工具目录或本地 ZIP 压缩包导入，自带面板与 /skills 命令。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "locale",
    "LICENSE",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill-manager",
    "zip-import",
    "技能",
    "技能管理",
    "导入"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "packages/dsh-skills"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/packages/dsh-skills#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
