{
  "name": "dsh-notify",
  "version": "0.1.0",
  "description": "Task reminders for DeepSeek Harness: approval, question, turn done and answer ready, each with an in-page popup, a bundled sound and a browser notification. Subscribes host-side and streams over SSE. Ships a panel and the /notify command. dsh-notify：dsh 任务提醒——四类事件（等待批准/等待回答/任务完成/回答就绪）弹窗、音效与系统通知，自带面板与 /notify 命令。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "locale",
    "LICENSE",
    "sounds",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "ui": {
      "feature": {
        "key": "notify",
        "order": 50,
        "title": {
          "zh": "任务提醒",
          "en": "Reminders"
        },
        "summary": {
          "zh": "回合完成的提醒与提示音",
          "en": "Turn reminders and sounds"
        }
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "reminder",
    "toast",
    "sound",
    "提醒",
    "通知"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "packages/dsh-notify"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/packages/dsh-notify#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
