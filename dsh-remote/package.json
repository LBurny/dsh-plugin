{
  "name": "dsh-remote",
  "version": "0.2.0",
  "description": "Phone remote access for DeepSeek Harness: an authenticated reverse proxy inside the dsh process, LAN or Cloudflare tunnel, QR link, mobile UI rewrite and a phone-side project browser. dsh-remote：手机远程访问 dsh——进程内带鉴权反向代理、局域网/隧道两通道、二维码、移动端界面改写与「项目」浏览，自带面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "ui": {
      "feature": {
        "key": "remote",
        "order": 60,
        "title": {
          "zh": "手机远程访问",
          "en": "Remote"
        },
        "summary": {
          "zh": "手机访问与二维码",
          "en": "Phone access and QR code"
        }
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote",
    "mobile",
    "phone",
    "cloudflare-tunnel",
    "reverse-proxy",
    "远程访问",
    "手机"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "dsh-remote"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/dsh-remote#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
