{
  "name": "dsh-zoom",
  "version": "0.1.0",
  "description": "Page zoom for the DeepSeek Harness web UI with rebindable shortcuts (press a key to record one), adjustable level and step. Ships a panel. dsh-zoom：dsh 网页界面缩放，快捷键可自定义，自带面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "ui": {
      "feature": {
        "key": "zoom",
        "order": 50,
        "title": {
          "zh": "页面缩放",
          "en": "Zoom"
        },
        "summary": {
          "zh": "界面缩放与快捷键",
          "en": "UI scale and shortcuts"
        }
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zoom",
    "shortcuts",
    "keybinding",
    "缩放",
    "快捷键"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBurny/dsh-plugin.git",
    "directory": "dsh-zoom"
  },
  "homepage": "https://github.com/LBurny/dsh-plugin/tree/main/dsh-zoom#readme",
  "bugs": {
    "url": "https://github.com/LBurny/dsh-plugin/issues"
  }
}
